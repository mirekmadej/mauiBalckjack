<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mauiBalckjack.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            BackgroundColor="AntiqueWhite"
            >


            <Label Text="komputer" />
            <HorizontalStackLayout
                HeightRequest="150"
                >
  
            </HorizontalStackLayout>
            <Rectangle HeightRequest="2" BackgroundColor="Black" />
            <HorizontalStackLayout
                HeightRequest="150"
                Spacing="10"
                x:Name="hslGracz"
                >

            </HorizontalStackLayout>
            <StackLayout
                IsVisible="False"
                x:Name="slGra"
                >
                <Label 
                    Text="punkty gracza: 0"
                    x:Name="lblPunkty"
                    />
                <HorizontalStackLayout Spacing="10">
                    <Button
                        Text="pass"
                        WidthRequest="100"
                        />
                    <Button
                        Text="daj kartę"
                        WidthRequest="100"
                        Clicked="BtnDajKarteKlik"
                        />
                </HorizontalStackLayout>
                
            </StackLayout>
            <StackLayout
                IsVisible="True"
                x:Name="slStart"
                >
                <Button
                    Text="Nowa gra"
                    Clicked="BtnNowaGraKlik"
                    />
            </StackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
