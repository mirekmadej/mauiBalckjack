<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mauiBalckjack.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            BackgroundColor="AntiqueWhite"
            >


            <Label Text="komputer" />
            
            <HorizontalStackLayout
                HeightRequest="150"
                Spacing="10"
                x:Name="hslKomputer"
                >
            </HorizontalStackLayout>
            <Label x:Name="lblPunktyKomputera" />
            
            
            <Rectangle HeightRequest="2" BackgroundColor="Black" />
            <HorizontalStackLayout
                HeightRequest="150"
                Spacing="10"
                x:Name="hslGracz"
                >

            </HorizontalStackLayout>

            <Label 
                Text=""
                x:Name="lblPunkty"
                />
            
            <StackLayout
                IsVisible="False"
                x:Name="slGra"
                >
                <HorizontalStackLayout Spacing="10">
                    <Button
                        Text="pass"
                        WidthRequest="100"
                        Clicked="BtnPassKlik"
                        />
                    <Button
                        Text="daj kartę"
                        WidthRequest="100"
                        Clicked="BtnDajKarteKlik"
                        />
                </HorizontalStackLayout>
                
            </StackLayout>
            <StackLayout
                IsVisible="True"
                x:Name="slStart"
                >
                <Button
                    Text="Nowa gra"
                    Clicked="BtnNowaGraKlik"
                    />
            </StackLayout>
            <Label
                Text="" 
                x:Name="lblStatystyka"
                />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
